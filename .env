# Application
ENVIRONMENT=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=itcredibl-enterprise-demo-key-change-in-production
JWT_ALGORITHM=HS256

# Redis
REDIS_URL=redis://localhost:6379/0

# Database (Using SQLite for compatibility)
DATABASE_URL=sqlite:///./itcredibl_demo.db

# ITCREDIBL API
ITCREDIBL_API_KEY=itcr_e89c3654baa25f4541c9591bd992a0e270cae42f223908aa2d6bcf66092cae7a
ITCREDIBL_BASE_URL=https://api.itcredibl.com

# Policy Engine
PII_DETECTION_ENABLED=true
COMPLIANCE_ENFORCEMENT=true

# Cost Controls
BUDGET_ENFORCEMENT=true
DEFAULT_BUDGET_USD=1000.0

# MCP
MCP_ENABLED=true