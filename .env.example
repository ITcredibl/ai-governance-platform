# API Configuration
ENVIRONMENT=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=your-super-secure-secret-key
JWT_ALGORITHM=HS256

# ITCREDIBL API
ITCREDIBL_BASE_URL=https://api.itcredibl.com
ITCREDIBL_API_KEY=your-itcredibl-api-key

# Redis
REDIS_URL=redis://localhost:6379/0

# Database (optional)
DATABASE_URL=postgresql://user:pass@localhost:5432/governance